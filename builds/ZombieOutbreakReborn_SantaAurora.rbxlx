      <Item class="Script" referent="12">
        <Properties>
          <string name="Name">Combat</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Tiro validado no servidor, munição e knockback para zumbis.
local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Remote=Instance.new("RemoteEvent")
Remote.Name="ZO_FireRifle"
Remote.Parent=ReplicatedStorage
local magazine: {[Player]:number}={}
local reserve: {[Player]:number}={}
local lastShot: {[Player]:number}={}
local MAX_AMMO=30
local MAX_RESERVE=120
local SHOT_DELAY=.105
local MAX_DISTANCE=280
local function sync(p:Player)
    p:SetAttribute("ZO_Ammo",magazine[p] or MAX_AMMO)
    p:SetAttribute("ZO_Reserve",reserve[p] or MAX_RESERVE)
end
local function reset(p:Player)
    magazine[p]=MAX_AMMO
    reserve[p]=MAX_RESERVE
    lastShot[p]=0
    sync(p)
end
Players.PlayerAdded:Connect(function(p)
    reset(p)
    p:GetPropertyChangedSignal("Team"):Connect(function()
        if p.Team and p.Team.Name=="Humans" then reset(p) end
    end)
end)
for _,p in ipairs(Players:GetPlayers()) do reset(p) end
Players.PlayerRemoving:Connect(function(p)
    magazine[p]=nil
    reserve[p]=nil
    lastShot[p]=nil
end)
Remote.OnServerEvent:Connect(function(p:Player,action:any,direction:any)
    if not p.Team or p.Team.Name~="Humans" then return end
    if ReplicatedStorage:GetAttribute("ZO_RoundState")~="Active" then return end
    local character=p.Character
    local head=character and character:FindFirstChild("Head")
    local humanoid=character and character:FindFirstChildOfClass("Humanoid")
    if not head or not head:IsA("BasePart") or not humanoid or humanoid.Health<=0 then return end
    if action=="Reload" then
        local needed=MAX_AMMO-(magazine[p] or 0)
        local take=math.min(needed,reserve[p] or 0)
        magazine[p]=(magazine[p] or 0)+take
        reserve[p]=(reserve[p] or 0)-take
        sync(p)
        return
    end
    if action~="Fire" or typeof(direction)~="Vector3" then return end
    local magnitude=direction.Magnitude
    if magnitude<.98 or magnitude>1.02 then return end
    if direction:Dot(head.CFrame.LookVector)<0.55 then return end
    local now=os.clock()
    if now-(lastShot[p] or 0)<SHOT_DELAY then return end
    if (magazine[p] or 0)<=0 then return end
    lastShot[p]=now
    magazine[p]-=1
    sync(p)
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances={character}
    local hit=workspace:Raycast(head.Position,direction*MAX_DISTANCE,params)
    if not hit then return end
    local part=hit.Instance
    local victimChar=part:FindFirstAncestorOfClass("Model")
    local victim=victimChar and Players:GetPlayerFromCharacter(victimChar)
    if not victim or not victim.Team or victim.Team.Name~="Zombies" then return end
    local targetHumanoid=victimChar:FindFirstChildOfClass("Humanoid")
    local root=victimChar:FindFirstChild("HumanoidRootPart")
    if not targetHumanoid or targetHumanoid.Health<=0 then return end
    local damage=if part.Name=="Head" then 38 else 18
    targetHumanoid:TakeDamage(damage)
    if root and root:IsA("BasePart") then
        local away=root.Position-head.Position
        local horizontal=Vector3.new(away.X,0,away.Z)
        if horizontal.Magnitude>.1 then
            local impulse=horizontal.Unit * root.AssemblyMass * (if part.Name == "Head" then 45 else 30)
            root:ApplyImpulse(impulse)
        end
    end
    Remote:FireClient(p,"Hit",damage)
end)
print("[Zombie Outbreak] Combat server online")
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="13">
        <Properties>
          <string name="Name">MapDiagnostics</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Diagnostics never modify the scene or mistake geometry for gameplay approval.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("MapConfig"))
local map = Workspace:WaitForChild(Config.ModelName, 15)
if not map then
    warn("[ZO MAP] Santa Aurora missing. Open the supplied .rbxlx or sync default.project.json.")
    return
end
local parts, unanchored, lights = 0, 0, 0
for _, item in map:GetDescendants() do
    if item:IsA("BasePart") then
        parts += 1
        if not item.Anchored then unanchored += 1 end
    elseif item:IsA("Light") then
        lights += 1
    end
end
print(("[ZO MAP] %s: %d parts, %d lights, %d unanchored."):format(Config.DisplayName, parts, lights, unanchored))
if unanchored > 0 then
    warn("[ZO MAP] Unanchored map geometry detected; inspect before testing.")
end
for _, name in {"ZO_HarborCollision", "HarborLocks_Survival_Visual", "ZO_Survival", "ZO_TestSpawns"} do
    if Workspace:FindFirstChild(name) then
        warn("[ZO MAP] Legacy scene still in Workspace: " .. name .. ". Archive it before validating Santa Aurora; see README.")
    end
end
print("[ZO MAP] Studio audit: require(game.ServerStorage.ZO_Validation.SantaAuroraAudit)() in the SERVER Command Bar during Play.")
print("[ZO MAP] Geometry loaded. Visual quality, movement, combat and multiplayer still need Studio playtests.")
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="14">
        <Properties>
          <string name="Name">ZombieRound</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- Zombie Outbreak Reborn | Autoridade de rodada e infecção (servidor)
-- Survival: seleção de infectados, equipes e temporizadores no servidor.
local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("RoundConfig"))
local MapConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("MapConfig"))
local rng = Random.new()

local function ensureTeam(name: string, color: BrickColor): Team
    local team = Teams:FindFirstChild(name)
    if not team then
        team = Instance.new("Team")
        team.Name = name
        team.Parent = Teams
    end
    assert(team:IsA("Team"))
    team.TeamColor = color
    team.AutoAssignable = false
    return team
end

local lobby = ensureTeam("Lobby", BrickColor.new("Medium stone grey"))
local humans = ensureTeam("Humans", BrickColor.new("Bright blue"))
local zombies = ensureTeam("Zombies", BrickColor.new("Bright green"))

local world = Workspace:WaitForChild(MapConfig.ModelName)
local spawns = world:WaitForChild("Spawns")
local function getSpawn(name: string): BasePart
    local marker = spawns:WaitForChild(name)
    assert(marker:IsA("BasePart"), "Map spawn must be a BasePart: " .. name)
    return marker
end
local humanSpawn = getSpawn(MapConfig.HumanSpawn)
local zombieSpawn = getSpawn(MapConfig.ZombieSpawn)
local lobbySpawn = getSpawn(MapConfig.LobbySpawn)

local state = "Waiting"
local roundId = 0
local infectedThisRound: {[Player]: boolean} = {}
local initialSelection: {[Player]: boolean} = {}
local roundParticipants: {[Player]: boolean} = {}

local function setState(newState: string, remaining: number)
    state = newState
    ReplicatedStorage:SetAttribute("ZO_RoundState", state)
    ReplicatedStorage:SetAttribute("ZO_Remaining", remaining)
end

local function count(): (number, number)
    local h, z = 0, 0
    for player in pairs(roundParticipants) do
        if player.Parent == Players then
            if player.Team == humans then h += 1 end
            if player.Team == zombies then z += 1 end
        end
    end
    return h, z
end

local function updateCounts()
    local h, z = count()
    ReplicatedStorage:SetAttribute("ZO_Humans", h)
    ReplicatedStorage:SetAttribute("ZO_Zombies", z)
end

local function roleStyle(player: Player)
    local character = player.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        if player.Team == zombies then
            humanoid.MaxHealth = Config.ZombieHealth
            humanoid.Health = Config.ZombieHealth
            humanoid.WalkSpeed = Config.ZombieWalkSpeed
        else
            humanoid.MaxHealth = Config.HumanHealth
            humanoid.Health = Config.HumanHealth
            humanoid.WalkSpeed = Config.HumanWalkSpeed
        end
    end
    local highlight = character:FindFirstChild("ZO_RoleHighlight")
    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = "ZO_RoleHighlight"
        highlight.DepthMode = Enum.HighlightDepthMode.Occluded
        highlight.FillTransparency = 0.8
        highlight.OutlineTransparency = 0.25
        highlight.Parent = character
    end
    if highlight:IsA("Highlight") then
        highlight.FillColor = if player.Team == zombies then Color3.fromRGB(45, 165, 60) else Color3.fromRGB(50, 130, 220)
        highlight.OutlineColor = highlight.FillColor
        highlight.Enabled = player.Team ~= lobby
    end
end

local function teleport(player: Player, part: BasePart)
    local character = player.Character
    if not character then return end
    character:PivotTo(part.CFrame * CFrame.new(0, 5, 0))
end

local function setRole(player: Player, team: Team, move: boolean?)
    player.Team = team
    player.Neutral = false
    player:SetAttribute("ZO_Role", team.Name)
    roleStyle(player)
    if move then teleport(player, if team == zombies then zombieSpawn else humanSpawn) end
    updateCounts()
end

local function infect(player: Player)
    if state ~= "Active" or not roundParticipants[player] then return end
    if player.Team ~= humans or infectedThisRound[player] then return end
    infectedThisRound[player] = true
    setRole(player, zombies, false) -- mantém a posição onde houve infecção
end

local function onJoin(player: Player)
    setRole(player, lobby, false)
    player.CharacterAdded:Connect(function(character: Model)
        task.defer(function()
            local root = character:WaitForChild("HumanoidRootPart", 10)
            local humanoid = character:WaitForChild("Humanoid", 10)
            if not root or not humanoid or player.Parent ~= Players or player.Character ~= character then return end
            roleStyle(player)
            if state == "Active" and roundParticipants[player] then
                teleport(player, if player.Team == zombies then zombieSpawn else humanSpawn)
            elseif state ~= "Active" then
                teleport(player, lobbySpawn)
            end
        end)
    end)
end

Players.PlayerAdded:Connect(onJoin)
for _, player in ipairs(Players:GetPlayers()) do onJoin(player) end
Players.PlayerRemoving:Connect(function(player)
    infectedThisRound[player] = nil
    initialSelection[player] = nil
    roundParticipants[player] = nil
    updateCounts()
end)

task.spawn(function()
    while true do
        task.wait(Config.InfectionPoll)
        if state ~= "Active" then continue end
        local attackers = {}
        local victims = {}
        for player in pairs(roundParticipants) do
            if player.Parent ~= Players then continue end
            local character = player.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            local humanoid = character and character:FindFirstChildOfClass("Humanoid")
            if not root or not root:IsA("BasePart") or not humanoid or humanoid.Health <= 0 then continue end
            if player.Team == zombies then
                table.insert(attackers, root)
            elseif player.Team == humans and not infectedThisRound[player] then
                table.insert(victims, {player = player, root = root})
            end
        end
        for _, victim in ipairs(victims) do
            for _, attacker in ipairs(attackers) do
                local displacement = victim.root.Position - attacker.Position
                if displacement.Magnitude <= Config.InfectionDistance then
                    -- Closed walls and glazing must stop infection, even at arm's reach.
                    local params = RaycastParams.new()
                    params.FilterType = Enum.RaycastFilterType.Exclude
                    params.FilterDescendantsInstances = {attacker.Parent, victim.root.Parent}
                    if Workspace:Raycast(attacker.Position, displacement, params) then
                        continue
                    end
                    infect(victim.player)
                    break
                end
            end
        end
    end
end)

local function runCountdown(newState: string, seconds: number): boolean
    for remaining = seconds, 0, -1 do
        setState(newState, remaining)
        updateCounts()
        if #Players:GetPlayers() < Config.MinimumPlayers then return false end
        task.wait(1)
    end
    return true
end

setState("Waiting", 0)
updateCounts()
print("[Zombie Outbreak] Round system online")

while true do
    while #Players:GetPlayers() < Config.MinimumPlayers do
        setState("Waiting", 0)
        task.wait(1)
    end
    if not runCountdown("Intermission", Config.Intermission) then continue end
    local participants = Players:GetPlayers()
    roundParticipants = {}
    infectedThisRound = {}
    initialSelection = {}
    roundId += 1

    for _, player in ipairs(participants) do
        roundParticipants[player] = true
        setRole(player, humans, true)
    end

    local selectedCount = math.clamp(math.ceil(#participants * Config.InitialZombieRatio), 1, #participants - 1)
    -- Fisher-Yates para seleção sem repetição
    for i = #participants, 2, -1 do
        local j = rng:NextInteger(1, i)
        participants[i], participants[j] = participants[j], participants[i]
    end
    for i = 1, selectedCount do
        initialSelection[participants[i]] = true
    end

    if not runCountdown("Preparation", Config.Preparation) then
        for player in pairs(roundParticipants) do if player.Parent == Players then setRole(player, lobby) end end
        roundParticipants = {}
        updateCounts()
        continue
    end

    for player in pairs(initialSelection) do
        if player.Parent == Players and roundParticipants[player] then
            infectedThisRound[player] = true
            setRole(player, zombies, true)
        end
    end

    local result = "Humans"
    for remaining = Config.Duration, 0, -1 do
        setState("Active", remaining)
        updateCounts()
        local h, z = count()
        if h == 0 then
            result = "Zombies"
            break
        end
        if z == 0 or #Players:GetPlayers() < Config.MinimumPlayers then
            result = "Cancelled"
            break
        end
        task.wait(1)
    end

    ReplicatedStorage:SetAttribute("ZO_LastWinner", result)
    setState("Results", Config.Results)
    for player in pairs(roundParticipants) do
        if player.Parent == Players then setRole(player, lobby, false) end
    end
    roundParticipants = {}
    infectedThisRound = {}
    initialSelection = {}
    updateCounts()
    task.wait(Config.Results)
end
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerStorage" referent="15">
    <Properties>
      <string name="Name">ServerStorage</string>
